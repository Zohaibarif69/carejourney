# ─── Database ───────────────────────────────────────────
# SQLite file path (relative to project root)
DATABASE_PATH=./carejourney.db

# ─── SerpApi ─────────────────────────────────────────────
# https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key_here

# ─── LLM (Anthropic) ─────────────────────────────────────
# https://console.anthropic.com/keys
ANTHROPIC_API_KEY=your_anthropic_key_here
# Or use OpenAI:
# OPENAI_API_KEY=your_openai_key_here
LLM_PROVIDER=anthropic   # or "openai"

# ─── Perfect Corp ────────────────────────────────────────
# https://developer.perfectcorp.com
PERFECT_CORP_API_KEY=your_perfect_corp_key_here
PERFECT_CORP_API_URL=https://api.perfectcorp.com/v1

# ─── Foxit ───────────────────────────────────────────────
# https://developers.foxit.com
FOXIT_API_KEY=your_foxit_key_here
FOXIT_API_URL=https://api.foxit.com/v1

# ─── Nutrient DWS ────────────────────────────────────────
# https://www.nutrient.io/developers
NUTRIENT_API_KEY=your_nutrient_key_here
NUTRIENT_API_URL=https://api.nutrient.io/v1

# ─── Doctavian ───────────────────────────────────────────
# https://doctavian.com/developers
DOCTAVIAN_API_KEY=your_doctavian_key_here
DOCTAVIAN_API_URL=https://api.doctavian.com/v1

# ─── App ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Turso (cloud SQLite — replaces local better-sqlite3) ────────────────────
# Create a free DB at https://turso.tech, then:
#   turso db create carejourney
#   turso db tokens create carejourney
# For local dev you can use a file URL instead:
#   TURSO_DATABASE_URL=file:./carejourney.db
#   TURSO_AUTH_TOKEN=   (leave blank for local file)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-token-here

# ─── Vercel Blob (persistent file storage — replaces local /public/uploads) ──
# Dashboard → Storage → Create Blob Store → connect to project.
# Vercel auto-adds BLOB_READ_WRITE_TOKEN. For local dev copy it to .env.local.
# Set USE_LOCAL_STORAGE=true to skip Blob and use ./public/uploads locally.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here
# USE_LOCAL_STORAGE=true
